# Firebase web config is public and is supplied at runtime.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=

# Optional local emulators (omit in production).
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8088

# Production worker accepts a Google-signed OIDC token for this exact audience and account.
SCHEDULER_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=
# Optional isolated development worker secret, never accepted in production.
# DEV_SCHEDULER_KEY=

# Reminder email requires an explicit provider, an HTTPS app URL, and REMINDER_EMAIL_ENABLED=true.
REMINDER_EMAIL_ENABLED=false
# Set to gmail or resend when configuring a provider.
REMINDER_EMAIL_PROVIDER=
APP_URL=
GMAIL_SMTP_USER=
# Inject GMAIL_SMTP_APP_PASSWORD from Secret Manager on Cloud Run.
GMAIL_SMTP_APP_PASSWORD=
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
GEMINI_API_KEY=
# Alternatively use the Cloud Run service account through Vertex AI.
GEMINI_VERTEX_PROJECT=
GEMINI_MODEL=gemini-3.8-flash
